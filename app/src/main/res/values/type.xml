<?xml version="1.0" encoding="utf-8"?>
<!--
    Typography.
      Tanker  - the app name only
      Boska   - headings and sub-headings (Display, Headline, Title Large/Medium)
      Satoshi - everything else (body, labels, buttons, fields)
    Sizes follow Material 3; only the fonts and spacing change.
-->
<resources>
    <style name="TextAppearance.ModelStash.AppName" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/tanker_regular</item>
        <item name="android:fontFamily">@font/tanker_regular</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.ModelStash.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/quilon_semibold</item>
        <item name="android:fontFamily">@font/quilon_semibold</item>
    </style>
    <style name="TextAppearance.ModelStash.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/quilon_semibold</item>
        <item name="android:fontFamily">@font/quilon_semibold</item>
    </style>
    <style name="TextAppearance.ModelStash.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/quilon_semibold</item>
        <item name="android:fontFamily">@font/quilon_semibold</item>
    </style>
    <style name="TextAppearance.ModelStash.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/quilon_semibold</item>
        <item name="android:fontFamily">@font/quilon_semibold</item>
    </style>
    <style name="TextAppearance.ModelStash.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/quilon_semibold</item>
        <item name="android:fontFamily">@font/quilon_semibold</item>
    </style>
    <style name="TextAppearance.ModelStash.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/quilon_semibold</item>
        <item name="android:fontFamily">@font/quilon_semibold</item>
    </style>
    <style name="TextAppearance.ModelStash.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/quilon_medium</item>
        <item name="android:fontFamily">@font/quilon_medium</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="TextAppearance.ModelStash.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/quilon_medium</item>
        <item name="android:fontFamily">@font/quilon_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.ModelStash.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/satoshi_bold</item>
        <item name="android:fontFamily">@font/satoshi_bold</item>
    </style>
    <style name="TextAppearance.ModelStash.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/satoshi</item>
        <item name="android:fontFamily">@font/satoshi</item>
    </style>
    <style name="TextAppearance.ModelStash.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/satoshi</item>
        <item name="android:fontFamily">@font/satoshi</item>
    </style>
    <style name="TextAppearance.ModelStash.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/satoshi</item>
        <item name="android:fontFamily">@font/satoshi</item>
    </style>
    <style name="TextAppearance.ModelStash.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/satoshi_bold</item>
        <item name="android:fontFamily">@font/satoshi_bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TextAppearance.ModelStash.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/satoshi_medium</item>
        <item name="android:fontFamily">@font/satoshi_medium</item>
    </style>
    <style name="TextAppearance.ModelStash.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/satoshi_medium</item>
        <item name="android:fontFamily">@font/satoshi_medium</item>
    </style>

    <!-- Small upper-case label above sections, e.g. "YOUR STASH" -->
    <style name="TextAppearance.ModelStash.Overline" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/satoshi_bold</item>
        <item name="android:fontFamily">@font/satoshi_bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>