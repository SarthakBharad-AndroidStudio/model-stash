<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: what Google's automatic backup and "copy apps and data" to a new
    phone take. The cloud backup is capped at 25 MB, so it gets the kit list and
    settings only; a direct phone-to-phone transfer has no such cap and takes the
    photos too. For a complete backup you control, use Backup & data in the app.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
