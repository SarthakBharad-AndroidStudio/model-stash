<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen photo viewer: photos on black, with a close button and caption on top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_viewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Not clickable, so touches go through to the photo except on the button itself -->
    <FrameLayout
        android:id="@+id/viewer_chrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/button_viewer_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/viewer_close"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/text_viewer_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_photo_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@android:color/white"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
