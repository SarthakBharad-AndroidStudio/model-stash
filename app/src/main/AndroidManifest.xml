<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only used when you tap "Fetch details" for a Scalemates link. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The camera is optional: the app still installs on devices without one. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".ModelStashApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ModelStash"
        tools:targetApi="31">

        <!-- Starts with the splash-screen theme; MainActivity swaps to the normal theme. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ModelStash.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- exported + SEND filter = appears in the browser's Share menu as "Add to Model Stash". -->
        <activity
            android:name=".ui.AddEditModelActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ModelDetailActivity"
            android:exported="false"
            android:label="@string/title_details" />

        <!-- Gives the camera app temporary permission to write one photo file. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>